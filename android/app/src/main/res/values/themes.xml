<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cdmm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cdmm_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Cdmm.Panel" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.38</item>
        <item name="android:colorAccent">#E9826A</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowAnimationStyle">@style/CdmmPanelMotion</item>
    </style>
    <style name="CdmmPanelMotion">
        <item name="android:windowEnterAnimation">@anim/panel_enter</item>
        <item name="android:windowExitAnimation">@anim/panel_exit</item>
    </style>
</resources>
